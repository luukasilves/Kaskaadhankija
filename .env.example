# Kaskaadhankija — configuration.
#
# Copy to `.env.local` for local work. On Fly, the non-secret values live in
# fly.toml's [env] block and the SMTP credentials in `fly secrets set`.
# Everything here has a working default except SMTP, which is optional.

# ---------------------------------------------------------------- database
# One SQLite file. In the container this points at the mounted volume.
DATABASE_PATH=./data/kaskaadhankija.db

# ------------------------------------------------------------ test environment
# This deployment is the test environment. It no longer switches on a harness —
# there is no virtual clock and no reset since v2.3 [L-23] — but four things
# read it: a buyer admin may act as a participant, the TESTKESKKOND badge
# appears, an empty allowed-recipients set means silence rather than everyone
# [L-19], and a round's
# response deadline may be minutes rather than working days. A production
# deployment simply leaves it out; the sign-in is the front door either way.
DEMO_MODE=1

# How short a test round's response window may be, in seconds. Only read in
# DEMO_MODE; production always uses the lot's own working-day window and a
# deadline can never be shortened [V-04]. Five minutes is right for a person
# trying the environment; the browser suites set a few seconds so a walk does
# not spend five minutes waiting.
# TEST_DEADLINE_FLOOR_SECONDS=300

# Used in notification links. Set it to the real origin in a deployment.
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------- email
# Optional. Without SMTP_HOST the in-app notification log is the only channel,
# which is what the test deployment runs on. With it, every notification is
# also emailed, and each notification row records whether the send succeeded.
# SMTP_HOST=smtp.example.ee
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Kaskaadhankija <tellimused@example.ee>

# Where the buyer team's summaries go. Empty falls back to the active admin
# users' addresses.
# TEAM_NOTIFICATIONS_EMAIL=tellimused@example.ee

# Who may receive real mail, *besides* the framework's own contacts [L-19].
#
# Every active partner representative and every active lot contact is allowed
# automatically, derived from the uploaded framework data — a bidder never has
# to be named here. This list is for the people the framework does not contain:
# the buyer's team, the team mailbox, testers. Addresses and whole domains,
# comma-separated (`@riigikantselei.ee, keegi@riik.ee`).
#
# Anything in neither set is recorded as "suppressed" and never attempted. With
# both sets empty, DEMO_MODE sends nothing at all; without DEMO_MODE an empty
# set allows everyone. `*` opens it explicitly.
# EMAIL_ALLOWED_RECIPIENTS=@riigikantselei.ee
# SMTP_TIMEOUT_MS=15000

# Print the emails to the log instead of sending them, even when SMTP is
# configured — useful when developing the notification copy.
# EMAIL_DEV_MODE=1

# ---------------------------------------------------------------- sign-in
# Signs one-time sign-in codes and session tokens. Required for sign-in outside
# DEMO_MODE. On Fly the deploy workflow generates it once; locally use
# `openssl rand -hex 32`.
# AUTH_SECRET=

# Who may sign in as a buyer **admin** without being added to the team first:
# a comma-separated list of whole addresses and/or whole domains. An entry with
# a local part is one person (`luukas.ilves@riigikantselei.ee`); an entry that
# is only a domain (`@naidis.ee`) is everybody holding a mailbox there.
#
# A named list is the access model for a real procurement — a whole domain
# means anyone at that domain can publish rounds and confirm allocations, both
# irreversible, so keep it to test environments [L-08]. The user row is created
# when a code is **verified**, never when one is requested, and the list never
# reactivates somebody an admin switched off. Empty means only people an admin
# has listed on *Meeskond* can sign in at all.
#
# Everyone else added on *Meeskond* starts as a **hankija**: they run rounds
# from start to finish, and read the framework data and the team without
# changing them [R-01].
#
# The address still has to be an allowed mail recipient for the code to be
# delivered — and for a buyer-side address that means EMAIL_ALLOWED_RECIPIENTS,
# since only the framework's own contacts are derived [L-19].
# AUTO_ADMIN_ALLOWLIST=luukas.ilves@riigikantselei.ee

# ---------------------------------------------------------------- seed
# The seed runs once, on an empty database, through the same framework import an
# admin would use [L-21]. The buyer it creates is the label the example rounds
# were replayed as, and the name that appears in the audit log beside them.
SEED_ADMIN_NAME=Mari Tamm
SEED_ADMIN_EMAIL=mari.tamm@naidis.riigikantselei.ee

# The buyer team's real members, added when the seed runs, so the first boot of
# a fresh volume already has the people who sign in: `nimi,e-post[,roll]`
# separated by `;`, **hankija** unless the role says `admin`. Added *alongside*
# the sample SEED_ADMIN, not instead, so the example rounds still read as the
# specialists reviewed them. Keep it in the deployment's secrets.
#
# Ask for `admin` by name: a seeded entry must not quietly hand out the right
# to publish rounds for the whole framework. Getting the first admin in is
# AUTO_ADMIN_ALLOWLIST's job, above.
# SEED_TEAM=Luukas Ilves,luukas@example.org,admin;Kirke Kask,kirke@example.org
#
# Partner representatives are deliberately absent here: they are the framework
# data's own contacts, and arrive with the workbook an admin uploads [L-21].
